<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        白い熊 連結浄化: the black-yellow look, set at the THEME rather than screen by screen.
        These framework attributes are what tint the parts no view walk can reach — the action bar,
        the up arrow and overflow, menu text, switch and seek-bar states, spinner arrows, dividers
        and link text. Anything left over is finished at runtime by ShiroikumaApp.
    -->
    <style name="ShiroikumaBase" parent="android:Theme.DeviceDefault">
        <item name="colorAccent">@color/sk_yellow</item>
        <item name="android:colorAccent">@color/sk_yellow</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textViewStyle">@style/MyTextViewStyle</item>

        <!-- surfaces -->
        <item name="android:colorBackground">@color/sk_black</item>
        <item name="android:windowBackground">@color/sk_black</item>

        <!-- text -->
        <item name="android:textColorPrimary">@color/sk_yellow</item>
        <item name="android:textColorSecondary">@color/sk_yellow_dim</item>
        <item name="android:textColorTertiary">@color/sk_yellow_dim</item>
        <item name="android:textColorHint">@color/sk_yellow_dim</item>
        <!-- links were the platform light blue; the fork has one accent and this is it -->
        <item name="android:textColorLink">@color/sk_yellow</item>

        <!-- controls: switches, checkboxes, seek bars, spinner arrows, icon tints -->
        <item name="android:colorControlNormal">@color/sk_yellow</item>
        <item name="android:colorControlActivated">@color/sk_yellow</item>
        <item name="android:colorControlHighlight">@color/sk_yellow_ripple</item>

        <!-- the action bar: full black, yellow title, yellow menu text -->
        <item name="android:actionBarStyle">@style/ShiroikumaActionBar</item>
        <item name="android:actionMenuTextColor">@color/sk_yellow</item>
        <item name="android:actionBarItemBackground">@color/transparent</item>

        <item name="android:listDivider">@drawable/sk_divider</item>

        <!-- The overflow / options menu popup: black panel, yellow border, yellow items. -->
        <item name="android:actionOverflowMenuStyle">@style/ShiroikumaOverflowMenu</item>
        <item name="android:popupMenuStyle">@style/ShiroikumaPopupMenu</item>
        <item name="android:textAppearanceLargePopupMenu">@style/ShiroikumaPopupText</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/ShiroikumaPopupText</item>
        <item name="android:panelBackground">@drawable/sk_dialog_background</item>
        <item name="android:itemBackground">@color/transparent</item>
        <item name="android:itemTextAppearance">@style/ShiroikumaPopupText</item>
        <item name="android:alertDialogTheme">@style/ShiroikumaAlertDialog</item>
    </style>

    <style name="ActivityThemeDark" parent="ShiroikumaBase" />

    <!--
        The light theme is upstream's; the fork is black-yellow either way, so it inherits the same
        base. Turning the master switch off in the 白い熊 連結浄化 UI page is what returns stock
        styling, not this.
    -->
    <style name="ActivityThemeLight" parent="ShiroikumaBase" />

    <style name="DialogThemeDark" parent="ShiroikumaDialog" />

    <style name="DialogThemeLight" parent="ShiroikumaDialog" />

    <!-- The link dialog. windowBackground carries the yellow border and, crucially, stops the
         platform's light dialog panel peeking out from behind the content. -->
    <style name="ShiroikumaDialog" parent="android:Theme.DeviceDefault.Dialog">
        <item name="colorAccent">@color/sk_yellow</item>
        <item name="android:colorAccent">@color/sk_yellow</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textViewStyle">@style/MyTextViewStyle</item>
        <item name="android:colorBackground">@color/sk_black</item>
        <item name="android:windowBackground">@drawable/sk_dialog_background</item>
        <item name="android:textColorPrimary">@color/sk_yellow</item>
        <item name="android:textColorSecondary">@color/sk_yellow_dim</item>
        <item name="android:textColorTertiary">@color/sk_yellow_dim</item>
        <item name="android:textColorHint">@color/sk_yellow_dim</item>
        <item name="android:textColorLink">@color/sk_yellow</item>
        <item name="android:colorControlNormal">@color/sk_yellow</item>
        <item name="android:colorControlActivated">@color/sk_yellow</item>
        <item name="android:colorControlHighlight">@color/sk_yellow_ripple</item>
        <item name="android:listDivider">@drawable/sk_divider</item>
        <item name="android:alertDialogTheme">@style/ShiroikumaAlertDialog</item>
    </style>

    <!-- AlertDialogs raised by the app (pickers, confirmations, the export result). -->
    <style name="ShiroikumaAlertDialog" parent="android:Theme.DeviceDefault.Dialog.Alert">
        <item name="android:colorAccent">@color/sk_yellow</item>
        <item name="android:colorBackground">@color/sk_black</item>
        <item name="android:windowBackground">@drawable/sk_dialog_background</item>
        <item name="android:textColorPrimary">@color/sk_yellow</item>
        <item name="android:textColorSecondary">@color/sk_yellow_dim</item>
        <item name="android:textColorLink">@color/sk_yellow</item>
        <item name="android:colorControlNormal">@color/sk_yellow</item>
        <item name="android:colorControlActivated">@color/sk_yellow</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ShiroikumaOverflowMenu" parent="android:Widget.DeviceDefault.PopupMenu">
        <item name="android:popupBackground">@drawable/sk_dialog_background</item>
    </style>

    <style name="ShiroikumaPopupMenu" parent="android:Widget.DeviceDefault.PopupMenu">
        <item name="android:popupBackground">@drawable/sk_dialog_background</item>
    </style>

    <style name="ShiroikumaPopupText"
        parent="android:TextAppearance.DeviceDefault.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/sk_yellow</item>
    </style>

    <style name="ShiroikumaActionBar" parent="android:Widget.DeviceDefault.ActionBar">
        <item name="android:background">@color/sk_black</item>
        <item name="android:titleTextStyle">@style/ShiroikumaActionBarTitle</item>
        <item name="android:subtitleTextStyle">@style/ShiroikumaActionBarSubtitle</item>
    </style>

    <style name="ShiroikumaActionBarTitle"
        parent="android:TextAppearance.DeviceDefault.Widget.ActionBar.Title">
        <item name="android:textColor">@color/sk_yellow</item>
    </style>

    <style name="ShiroikumaActionBarSubtitle"
        parent="android:TextAppearance.DeviceDefault.Widget.ActionBar.Subtitle">
        <item name="android:textColor">@color/sk_yellow_dim</item>
    </style>

    <style name="MyTextViewStyle" parent="android:Widget.TextView">
        <!-- can't use padding, it won't be overrideable -->
        <item name="android:paddingLeft">5dp</item>
        <item name="android:paddingStart">5dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingRight">5dp</item>
        <item name="android:paddingEnd">5dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>
</resources>
