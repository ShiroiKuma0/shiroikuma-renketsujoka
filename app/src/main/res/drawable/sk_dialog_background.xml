<?xml version="1.0" encoding="utf-8"?>
<!-- The link dialog's own window background: black with a yellow border. Without this the
     DeviceDefault dialog background (a light rounded panel) peeks out from behind the content. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/sk_black" />
    <stroke
        android:width="2dp"
        android:color="@color/sk_yellow" />
    <corners android:radius="12dp" />
</shape>
